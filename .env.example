# Supabase — server-side only (service_role bypasses RLS, never expose to client)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Conversation history: the Postgres where the n8n agents store real lead
# conversations (one schema per client, each with a `chats` table). Until
# August 2026 this was a second Supabase project read over PostgREST; it is now
# a direct connection, which is also why no Management API token is needed any
# more to create a client's schema. Server-side only.
# Host/port let the deploy use EasyPanel's internal network instead of the
# public address; blank uses the public default.
CHATS_DB_HOST=
CHATS_DB_PORT=
CHATS_DB_USER=
CHATS_DB_NAME=
# The only required one. Blank disables the history panel and the "Crear tabla
# de chats" provisioning option.
CHATS_DB_PASSWORD=

# AES-256-GCM key for encrypting provider API keys at rest.
# Generate with: openssl rand -hex 32
# WARNING: rotating this invalidates all previously stored provider keys.
KEY_ENCRYPTION_SECRET=

# Optional build tag shown in the footer.
NEXT_PUBLIC_BUILD_TAG=

# ---------------------------------------------------------------------------
# Login "Entrar con Google" (restricts access to the company domain).
# The app talks to Google directly and mints its own signed session cookie;
# no external auth service is involved.
# ---------------------------------------------------------------------------

# OAuth Client (Google Cloud Console, "Aplicacion web").
# Authorized redirect URI must be: <app base url>/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Secret used to sign the session cookie. Generate with: openssl rand -hex 32
AUTH_SESSION_SECRET=

# Company domain allowed to log in. Only emails ending in @<this> get access.
AUTH_ALLOWED_DOMAIN=zebradigital.marketing

# Public base URL of the app. Recommended behind the EasyPanel proxy so the
# OAuth redirect URI is deterministic. No trailing slash.
# Example: https://dashboard-prompt-benchmark.9qd6cz.easypanel.host
AUTH_BASE_URL=

# --- Google Chat (opcional) ------------------------------------------------
# Avisa en un espacio de Chat cuando un cliente deja un reporte en su link de
# pruebas. El espacio se elige en Configuración; aquí van las credenciales de
# la cuenta de servicio. En blanco desactiva la integración: la app sigue
# avisando por la campana.
# La llave privada va en una sola línea, con los saltos como \n literales.
GOOGLE_CHAT_CLIENT_EMAIL=
GOOGLE_CHAT_PRIVATE_KEY=

# --- Herramientas del agente (opcional) ------------------------------------
# Hosts extra a los que puede llamar una herramienta de cliente, separados por
# comas. Los de Supabase (*.supabase.co) están permitidos siempre. En blanco
# deja solo Supabase, que es el caso normal.
# Ejemplo: api.cliente.mx,datos.otrocliente.com
TOOL_HOST_ALLOWLIST=
